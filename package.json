{
  "name": "starflight",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "inspect": "node scripts/inspect.ts",
    "typecheck-cli": "tsc --ignoreConfig --noEmit --module nodenext --target es2023 --types node --allowImportingTsExtensions --skipLibCheck scripts/inspect.ts scripts/forth-boot.test.ts",
    "test-boot": "node --test scripts/forth-boot.test.ts",
    "build": "tsc && vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "@alexaltea/capstone-js": "^5.0.9"
  }
}
